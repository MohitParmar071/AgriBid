<script type="module">
	import { createChat } from 'https://cdn.jsdelivr.net/npm/@n8n/chat/dist/chat.bundle.es.js';

	createChat({
		webhookUrl: 'https://mohitparmar0954.app.n8n.cloud/webhook/b7a200b2-f19b-41c1-9ba3-e432984a2d13/chat',
        initialMessages: [
            'Hello! 🌾 Welcome to AgriBid Support.',
            'I am here to help you 24/7 with crop prices, weather updates, or farming tips.',
            'You can type your question or use the quick suggestions below.'
