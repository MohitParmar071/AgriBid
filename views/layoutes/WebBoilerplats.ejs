<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <title>AgriBid - Smarter Farming</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🌾</text></svg>">
    <link  href="/css/home.css" rel="stylesheet">
    <style>
      /* Force hide google translate banner directly in HTML */
      iframe[src*="translate.googleapis.com"], iframe[id*="goog"], iframe.skiptranslate { display: none !important; }
      body > .skiptranslate { display: none !important; }
      .goog-te-banner-frame.skiptranslate, iframe.goog-te-banner-frame { display: none !important; }
      body { top: 0px !important; position: static !important; margin-top: 0px !important; }
      html { top: 0px !important; position: static !important; margin-top: 0px !important; }
      .goog-tooltip, .goog-tooltip:hover { display: none !important; }
      .goog-text-highlight { background-color: transparent !important; border: none !important; box-shadow: none !important; }
      #goog-gt-tt { display: none !important; }

      /* Layout & Sticky Footer Support */
      html, body {
        height: 100%;
        margin: 0;
      }
      body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }
      .container {
        flex-grow: 1;
        width: 100%;
        padding-bottom: 40px;
      }

      /* Professional Footer Premium Design */
      .pro-footer {
        flex-shrink: 0;
        background: #133316; /* Deep professional green */
        color: #e0e0e0;
        padding: 60px 0 0;
        font-family: 'Poppins', sans-serif;
      }
      .footer-primary {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1.5fr 1fr 1fr;
        gap: 40px;
        padding: 0 20px 40px;
      }
      .footer-column h4 {
        color: #ffffff;
        font-size: 1.1rem;
        margin-bottom: 20px;
        position: relative;
        padding-bottom: 10px;
        text-transform: uppercase;
        letter-spacing: 1px;
      }
      .footer-column h4::after {
        content: '';
        position: absolute;
        left: 0;
        bottom: 0;
        width: 40px;
        height: 2px;
        background: #28a745;
      }
      .footer-logo {
        font-size: 2rem;
        font-weight: 800;
        color: #fff;
        margin-bottom: 15px;
      }
      .footer-logo span { color: #28a745; font-weight: 400; }
      .footer-tagline {
        line-height: 1.6;
        font-size: 0.95rem;
        opacity: 0.8;
        margin-bottom: 25px;
      }
      .footer-social {
        display: flex;
        gap: 15px;
      }
      .footer-social a {
        width: 40px;
        height: 40px;
        background: rgba(255,255,255,0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        color: #fff;
        transition: all 0.3s ease;
        text-decoration: none;
        font-size: 1.1rem;
      }
      .footer-social a:hover {
        background: #28a745;
        transform: translateY(-5px);
        box-shadow: 0 5px 15px rgba(40,167,69,0.3);
      }
      .footer-column ul {
        list-style: none;
        padding: 0;
      }
      .footer-column ul li { margin-bottom: 15px; }
      .footer-column ul li a {
        color: #e0e0e0;
        text-decoration: none;
        font-size: 0.95rem;
        transition: 0.3s;
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .footer-column ul li a:hover { color: #28a745; padding-left: 8px; }
      
      .trust-style-item {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 20px;
        font-size: 0.95rem;
        background: rgba(255,255,255,0.03);
        padding: 10px 15px;
        border-radius: 8px;
        border-right: 3px solid transparent;
        transition: 0.3s;
      }
      .trust-style-item:hover { background: rgba(255,255,255,0.05); border-right-color: #28a745; }
      .trust-style-item i { color: #28a745; font-size: 1.25rem; }

      .footer-bottom {
        background: rgba(0,0,0,0.3);
        padding: 30px 20px;
        border-top: 1px solid rgba(255,255,255,0.05);
      }
      .bottom-content {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.9rem;
        opacity: 0.8;
      }
      .hindi-text { font-weight: 600; color: #28a745; margin-left: 8px; }
      .bottom-links { display: flex; gap: 25px; }
      .bottom-links a { color: #e0e0e0; text-decoration: none; transition: 0.3s; }
      .bottom-links a:hover { color: #28a745; }

      /* Simple Footer Styles */
      .simple-footer {
        flex-shrink: 0;
        background: #113014;
        color: rgba(255,255,255,0.7);
        padding: 20px 0;
        text-align: center;
        width: 100%;
        font-size: 0.85rem;
        border-top: 1px solid rgba(255,255,255,0.05);
      }

      @media (max-width: 992px) {
        .footer-primary { grid-template-columns: 1fr; gap: 40px; text-align: center; }
        .footer-column h4::after { left: 50%; transform: translateX(-50%); }
        .footer-social { justify-content: center; }
        .bottom-content { flex-direction: column; gap: 20px; text-align: center; }
      }
    </style>
</head>
<body>
    <%- include("../includes/webnavbar.ejs") %>
<!-- Popup Box -->
<div id="profilePopup" class="popup_identify">
  <div class="popup_header_identify">
    <span class="close_btn_identify" id="closePopup" title="Close"><i class="fa-solid fa-xmark"></i></span>
  </div>
  <div class="popup_content_identify">
    <div class="avatar-wrapper">
      <img src="<%= user && user.img ? user.img : 'https://cdn-icons-png.flaticon.com/512/149/149071.png' %>" onerror="this.src='https://cdn-icons-png.flaticon.com/512/149/149071.png'" alt="User" class="popup_avatar_identify">
      <label for="profileUpload" class="edit-avatar-btn" title="Change Profile Photo">
        <i class="fa-solid fa-pen"></i>
      </label>
      <input type="file" id="profileUpload" accept="image/*" style="display: none;">
    </div>
    <h3><%=user.name%></h3>
    
    <div class="user-details-box">
      <p class="user-email">
        <i class="fa-solid fa-envelope"></i> 
        <span><%=user.email%></span>
      </p>
      <p class="user-address">
        <i class="fa-solid fa-location-dot"></i> 
        <span><%=user.address%></span>
      </p>
    </div>
    
    <form method="get" action="/logout">
      <button class="btn_message_identify">
        <i class="fa-solid fa-right-from-bracket"></i> Logout
      </button>
    </form>
  </div>
</div>

        <div class="container">
           <%-body%>           
       </div>

       <% if (typeof hideFooter === 'undefined' || !hideFooter) { %>
         <%- include("../includes/webfooter.ejs", { type: typeof footerType !== 'undefined' ? footerType : 'simple' }) %>
       <% } %>

       <script>
// Profile popup
// Select elements
const profileBtn = document.getElementById("profileBtn");
const popup = document.getElementById("profilePopup");
const closePopup = document.getElementById("closePopup");
const overlay = document.getElementById("overlay");

if (profileBtn) {
  profileBtn.addEventListener("click", () => {
    popup.style.display = "block";
    overlay.style.display = "block";
  });
}

if (closePopup) {
  closePopup.addEventListener("click", () => {
    popup.style.display = "none";
    overlay.style.display = "none";
  });
}

if (overlay) {
  overlay.addEventListener("click", () => {
    popup.style.display = "none";
    overlay.style.display = "none";
  });
}

// Profile Photo Upload Logic
const profileUpload = document.getElementById("profileUpload");
if (profileUpload) {
  profileUpload.addEventListener("change", async function() {
    if (this.files && this.files[0]) {
      const formData = new FormData();
      formData.append("profileImage", this.files[0]);

      const labelBadge = document.querySelector(".edit-avatar-btn i");
      if(labelBadge) {
        labelBadge.className = "fa-solid fa-spinner fa-spin";
      }

      try {
        const response = await fetch("/upload-profile", {
          method: "POST",
          body: formData
        });
        
        const contentType = response.headers.get("content-type");
        if (contentType && contentType.indexOf("application/json") !== -1) {
          const data = await response.json();
          if (data.success) {
            document.querySelector(".popup_avatar_identify").src = data.img;
            document.getElementById("profileBtn").src = data.img;
          } else {
            alert("Failed to upload image: " + (data.error || "Unknown error"));
          }
        } else {
          const textData = await response.text();
          console.error("Server returned non-JSON:", textData);
          alert("Server Error: " + response.status + " " + response.statusText);
        }
      } catch (err) {
        console.error("Upload failed", err);
        alert("Upload request failed: " + err.message);
      } finally {
        if(labelBadge) {
          labelBadge.className = "fa-solid fa-pen";
        }
        this.value = '';
      }
    }
  });
}
       </script>
           
<!-- Google Translate Widget -->
<div id="google_translate_element" style="display:none;"></div>
<script type="text/javascript">
function googleTranslateElementInit() {
  new google.translate.TranslateElement({pageLanguage: 'en', autoDisplay: false}, 'google_translate_element');
}
function translatePage(lang) {
  if(!lang) return;
  document.cookie = "googtrans=/en/" + lang + "; path=/;";
  document.cookie = "googtrans=/en/" + lang + "; domain=." + document.domain + "; path=/;";
  window.location.reload();
}
</script>
<script type="text/javascript" src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
</body>
</html>