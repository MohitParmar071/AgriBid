        <% farmingArticles.forEach(article => { %>
          <a href="/article/<%= article.id %>" class="post">
            <div class="post-img-wrap">
              <% if (article.images && article.images.length > 0) { %>
                <% article.images.forEach((imgSrc, index) => { %>
                  <img src="<%= imgSrc %>" class="article-slide slide-<%= index %>" alt="<%= article.title %>"/>
                <% }) %>
              <% } else { %>
                <img src="<%= article.image %>" alt="<%= article.title %>"/>
              <% } %>
            </div>
            <div class="post-content">
              <h3><%= article.title %></h3>
              <p><%= article.excerpt %></p>
              <span class="btn-readmore">Read Full Article <i class="fa-solid fa-arrow-right"></i></span>
            </div>
          </a>
        <% }) %>
      <% } else { %>
        <p style="text-align: center; width: 100%; color: #666;">No articles available at the moment.</p>
      <% } %>
    </div>
  </section>

