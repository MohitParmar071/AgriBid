<!--boiler plats-->
<% layout("../layoutes/EnteringBoilerplats") %>
<link rel="stylesheet" href="/css/Register.css?v=2">


    <div class="form-container">
      <h2>Register</h2>
      <!-- enctype added -->
      <form method="post" action="/register" enctype="multipart/form-data">
        
        <% if (typeof error !== "undefined" && error) { %>
          <div class="alert error-alert">
            <i class="fa-solid fa-circle-exclamation"></i> <%= error %>
          </div>
        <% } %>
        
        <!-- Professional Avatar Upload -->
        <div class="avatar-upload-container">
          <div class="avatar-preview" onclick="document.getElementById('profilePicInput').click()" title="Choose Profile Photo">
            <div id="imagePreview"></div>
            <div class="avatar-overlay">
              <i class="fa-solid fa-camera"></i>
            </div>
          </div>
          <!-- The hidden actual file input -->
          <input type="file" id="profilePicInput" name="img" accept="image/*" required style="display: none;" onchange="previewAvatar(this)">
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>Name</label>
            <input type="text" name="con[username]" required>
          </div>
          <div class="form-group">
            <label>Mobile Number</label>
            <input type="text" name="con[mo_num]" required>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>Email</label>
            <input type="email" name="con[email]" required>
          </div>
          <div class="form-group">
            <label>Password</label>
            <div class="password-wrapper">
              <input type="password" id="reg-password" name="con[password]" required oninput="evaluatePassword(this.value)">
              <span class="toggle-password" onclick="togglePasswordVis('reg-password', this)"><i class="fa-solid fa-eye-slash"></i></span>
            </div>
            
            <div class="password-strength" id="pwd-strength" style="display: none;">
              <div class="strength-segments" id="strength-segments">
                <div class="segment" id="seg-1"></div>
                <div class="segment" id="seg-2"></div>
                <div class="segment" id="seg-3"></div>
                <div class="segment" id="seg-4"></div>
              </div>
              <span class="strength-text" id="strength-text"></span>
            </div>
            
          </div>
        </div>

        <div class="form-group">
          <label>Address</label>
          <input type="text" name="con[address]" required>
        </div>



        <div class="form-actions">
          <button type="submit">Register</button>
        </div>
      </form>
      <div class="login-link">
         <a href="/login">Already have an account? Login here</a>
      </div>
    </div>


  <script>
    function previewAvatar(input) {
      if (input.files && input.files[0]) {
        var reader = new FileReader();
        reader.onload = function(e) {
          document.getElementById('imagePreview').style.backgroundImage = 'url(' + e.target.result + ')';
        }
        reader.readAsDataURL(input.files[0]);
      }
    }

    function togglePasswordVis(inputId, iconSpan) {
      const input = document.getElementById(inputId);
      const icon = iconSpan.querySelector('i');
      if (input.type === "password") {
        input.type = "text";
        icon.classList.remove('fa-eye-slash');
        icon.classList.add('fa-eye');
      } else {
        input.type = "password";
        icon.classList.remove('fa-eye');
        icon.classList.add('fa-eye-slash');
      }
    }

    function evaluatePassword(val) {
      const container = document.getElementById('pwd-strength');
      const text = document.getElementById('strength-text');
      const segments = document.getElementById('strength-segments');
      const seg1 = document.getElementById('seg-1');
      const seg2 = document.getElementById('seg-2');
      const seg3 = document.getElementById('seg-3');
      const seg4 = document.getElementById('seg-4');
      
      if (!val) {
        container.style.display = 'none';
        return;
      }
      
      container.style.display = 'flex';
      let score = 0;
      
      if (val.length >= 8) score++;
      if (val.match(/[A-Z]/)) score++;
      if (val.match(/[0-9]/)) score++;
      if (val.match(/[^A-Za-z0-9]/)) score++;
      
      if (val.length > 0 && score === 0) score = 1;

      segments.className = 'strength-segments';
      seg1.className = 'segment';
      seg2.className = 'segment';
      seg3.className = 'segment';
      seg4.className = 'segment';

      if (score === 1) {
        seg1.classList.add('seg-active');
        text.innerText = 'Weak (Add numbers & special symbols)';
      } else if (score === 2) {
        seg1.classList.add('seg-active');
        seg2.classList.add('seg-active');
        text.innerText = 'Fair (Add uppercase letters)';
      } else if (score === 3) {
        seg1.classList.add('seg-active');
        seg2.classList.add('seg-active');
        seg3.classList.add('seg-active');
        text.innerText = 'Good (Almost there)';
      } else {
        seg1.classList.add('seg-active');
        seg2.classList.add('seg-active');
        seg3.classList.add('seg-active');
        seg4.classList.add('seg-active');
        text.innerText = 'Strong Password ✅';
      }
    }
  </script>