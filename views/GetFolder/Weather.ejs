<% layout("../layoutes/WebBoilerplats") %>
<link rel="stylesheet" href="/css/weather.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="weather-page">
    <!-- Dynamic Background Elements -->
    <div id="weather-bg-fx" class="weather-bg-fx"></div>

    <div class="weather-main-wrapper">
        <!-- Search Section -->
        <div class="search-container">
            <h1 class="page-title"><i class="fa-solid fa-cloud-sun-rain"></i> Agri-Weather Dashboard</h1>
            <form id="weather-form" class="glass-form">
                <div class="input-group">
                    <i class="fa-solid fa-location-dot"></i>
                    <input type="text" id="city-input" placeholder="Enter city name..." required />
                </div>
                <button type="submit" class="search-btn">
                    <span>Fetch Report</span>
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
            </form>
        </div>

        <div id="weather-content" class="weather-content hidden">
            <!-- Hero Section: Current Weather -->
            <div class="current-weather-hero animate-in">
                <div class="hero-glass">
                    <div class="main-info">
                        <h2 id="display-city">City Name</h2>
                        <span id="current-date">Sunday, 29th March</span>
                        <div class="temp-display">
                            <span id="current-temp">--</span>°
                            <img id="main-weather-icon" src="" alt="weather icon" class="hero-icon">
                        </div>
                        <p id="feels-like" class="feels-like-text">Feels like --°</p>
                        <p id="weather-desc" class="desc-text text-capitalize">Description</p>
                    </div>
                </div>

                <!-- Farmer Advisor Card -->
                <div class="advisor-card animate-in-delayed">
                    <div class="advisor-header">
                        <i class="fa-solid fa-seedling"></i>
                        <span>Farmer's Wisdom</span>
                    </div>
                    <p id="farmer-advice">Checking conditions for your crops...</p>
                </div>
            </div>

            <!-- Detailed Stats Grid -->
            <div class="stats-grid animate-in-more-delayed">
                <div class="stat-item glass">
                    <i class="fa-solid fa-droplet colored"></i>
                    <div class="stat-info">
                        <label>Humidity</label>
                        <span id="humidity-val">--%</span>
                    </div>
                </div>
                <div class="stat-item glass">
                    <i class="fa-solid fa-wind colored"></i>
                    <div class="stat-info">
                        <label>Wind Speed</label>
                        <span id="wind-val">-- km/h</span>
                    </div>
                </div>
                <div class="stat-item glass">
                    <i class="fa-solid fa-sun colored"></i>
                    <div class="stat-info">
                        <label>Pressure</label>
                        <span id="pressure-val">-- hPa</span>
                    </div>
                </div>
                <div class="stat-item glass">
                    <i class="fa-solid fa-eye colored"></i>
                    <div class="stat-info">
                        <label>Visibility</label>
                        <span id="visibility-val">-- km</span>
                    </div>
                </div>
                <div class="stat-item glass">
                    <i class="fa-solid fa-sunrise" style="color: #f39c12;"></i>
                    <div class="stat-info">
                        <label>Sunrise</label>
                        <span id="sunrise-val">--:--</span>
                    </div>
                </div>
                <div class="stat-item glass">
                    <i class="fa-solid fa-sunset" style="color: #e74c3c;"></i>
                    <div class="stat-info">
                        <label>Sunset</label>
                        <span id="sunset-val">--:--</span>
                    </div>
                </div>
            </div>

            <!-- 5-Day Forecast -->
            <div class="forecast-section animate-fade-up">
                <h3 class="section-subtitle">Upcoming Forecast</h3>
                <div class="forecast-grid" id="forecast-grid">
                    <!-- JS will populate this -->
                </div>
                <div class="chart-container glass animate-fade-up">
                    <canvas id="tempChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Initial Loader -->
        <div id="weather-loader" class="loader-container">
            <div class="spinner"></div>
            <p>Gathering atmospheric data...</p>
        </div>
    </div>
</div>

<script src="/js/weather.js"></script>
