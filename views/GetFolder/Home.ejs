        i18n: {
            en: {
                title: 'AgriBid Assistant',
                subtitle: 'Your personal farming guide',
                getStarted: 'Start Conversation',
                inputPlaceholder: 'Type a message...',
                footer: '',
            }
        }
	});

    // Advanced Shadow DOM Injection for Suggestion Chips & Input Styling
    setInterval(() => {
        // n8n-chat creates a wrapper div usually at the end of body. We look for shadowRoot.
        const chatWrappers = document.querySelectorAll('div');
        let shadow = null;
        for (let div of chatWrappers) {
            if (div.shadowRoot && div.shadowRoot.querySelector('.chat-window')) {
                shadow = div.shadowRoot;
                break;
            }
        }
        
        if (!shadow) return;

        // 1. Inject Premium Styles for Input Box and Header Fixes
        if (!shadow.querySelector('#agribid-chat-styles')) {
            const style = document.createElement('style');
            style.id = 'agribid-chat-styles';
            style.textContent = `
                .chat-header h1, .chat-header h2, .chat-header h3, .chat-header .title {
                    font-size: 20px !important;
                    line-height: 1.3 !important;
                    margin-bottom: 4px !important;
                    font-weight: 700 !important;
                    letter-spacing: 0.5px !important;
                    text-shadow: 1px 1px 3px rgba(0,0,0,0.2) !important;
                }
                .chat-header p, .chat-header small, .chat-header .subtitle {
                    font-size: 13px !important;
                    opacity: 0.9 !important;
                    font-weight: 400 !important;
                }
                .chat-footer {
                    padding: 15px 20px !important;
                    background: #ffffff !important;
                    border-top: 1px solid #e0e0e0 !important;
                    box-shadow: 0 -5px 15px rgba(0,0,0,0.02) !important;
                    border-bottom-left-radius: 20px !important;
                    border-bottom-right-radius: 20px !important;
                }
                .chat-footer textarea {
                    border-radius: 20px !important;
                    border: 1px solid #cfd8dc !important;
                    padding: 12px 16px !important;
                    font-family: inherit !important;
                    font-size: 14px !important;
                    background: #f4f7f6 !important;
                    resize: none !important;
                    transition: all 0.3s ease !important;
                }
                .chat-footer textarea:focus {
                    border-color: #4caf50 !important;
                    background: #ffffff !important;
                    outline: none !important;
                    box-shadow: 0 0 0 3px rgba(76, 175, 80, 0.2) !important;
                }
                .suggestions-container {
                    display: flex;
                    flex-wrap: wrap;
                    gap: 8px;
                    padding: 10px 20px 0px 20px;
                    background: #ffffff;
                }
                .suggestion-btn {
                    background: #e8f5e9;
                    color: #1b5e20;
                    border: 1px solid #c8e6c9;
                    padding: 8px 14px;
                    border-radius: 20px;
                    font-size: 13px;
                    cursor: pointer;
                    transition: all 0.2s ease;
                    font-weight: 600;
                    font-family: inherit;
                }
                .suggestion-btn:hover {
                    background: #1b5e20;
                    color: #fff;
                    transform: translateY(-2px);
                    box-shadow: 0 3px 8px rgba(27, 94, 32, 0.3);
                }
            `;
            shadow.appendChild(style);
        }

        // 2. Inject Smart Quick Reply Buttons
        const chatWindow = shadow.querySelector('.chat-window');
        const chatFooter = shadow.querySelector('.chat-footer');
        
        if (chatWindow && chatFooter && !shadow.querySelector('.suggestions-container')) {
            const suggestionsBox = document.createElement('div');
            suggestionsBox.className = 'suggestions-container';
            
            const createChip = (emoji, text, query) => {
                const btn = document.createElement('button');
                btn.className = 'suggestion-btn';
                btn.innerText = `${emoji} ${text}`;
                btn.onclick = () => {
                    const input = chatFooter.querySelector('textarea') || chatFooter.querySelector('input');
                    const sendBtn = chatFooter.querySelector('button[type="submit"]');
                    if (input) {
                        const nativeTextAreaValueSetter = Object.getOwnPropertyDescriptor(window.HTMLTextAreaElement.prototype, "value").set;
                        if(nativeTextAreaValueSetter) {
                            nativeTextAreaValueSetter.call(input, query);
                            input.dispatchEvent(new Event('input', { bubbles: true }));
                        } else {
                            input.value = query;
                            input.dispatchEvent(new Event('input', { bubbles: true }));
                        }
                        // Remove suggestions after clicking one
                        suggestionsBox.style.display = 'none';
                        setTimeout(() => { if (sendBtn) sendBtn.click(); }, 100);
                    }
                };
                return btn;
            };

            suggestionsBox.appendChild(createChip('🌾', 'Crop Prices', 'What are the current crop prices in the market?'));
            suggestionsBox.appendChild(createChip('🌦️', 'Weather', 'Can you tell me today\'s weather forecast?'));
            suggestionsBox.appendChild(createChip('🚜', 'Govt Schemes', 'What are the latest government agriculture schemes?'));
            
            chatWindow.insertBefore(suggestionsBox, chatFooter);
        }
    }, 1000);
</script>



