<!-- Blog Styling Overrides -->
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;700&display=swap" rel="stylesheet">
<style>
  .blog-posts {
    display: flex;
    flex-wrap: wrap;
    gap: 35px;
    justify-content: center;
    margin-top: 30px;
  }
  .post {
    background: #fff;
    padding: 0;
    border-top: 5px solid #43a047; /* Changed from border-left to border-top */
    border-radius: 20px;
    flex: 1 1 340px;
    max-width: 380px;
    box-shadow: 0 12px 35px rgba(0,0,0,0.06);
    display: flex !important;
    flex-direction: column !important;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    text-decoration: none;
    color: inherit;
    border: 1px solid rgba(0,0,0,0.03);
  }
  .post:hover {
    transform: translateY(-12px);
    box-shadow: 0 20px 45px rgba(46,125,50,0.12);
    border-color: rgba(67, 160, 71, 0.2);
  }
  .post-img-wrap {
    width: 100%;
    height: 220px;
    position: relative;
    overflow: hidden;
  }
  .post-img-wrap img {
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .post:hover .post-img-wrap img {
    transform: scale(1.1);
  }
  
  /* Article Slideshow Animations */
  .article-slide {
    opacity: 0;
    animation: articleFade 15s infinite;
  }
  .article-slide.slide-0 { animation-delay: 0s; }
  .article-slide.slide-1 { animation-delay: 5s; }
  .article-slide.slide-2 { animation-delay: 10s; }

  @keyframes articleFade {
    0% { opacity: 0; }
    5% { opacity: 1; }
    33% { opacity: 1; }
    38% { opacity: 0; }
    100% { opacity: 0; }
  }
  .post-content {
    padding: 25px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }
  .post h3 {
    font-family: 'Outfit', sans-serif;
    margin-bottom: 12px;
    font-size: 1.5rem;
    color: #1b5e20;
    line-height: 1.25;
    font-weight: 700;
  }
  .post p {
    color: #5d6d7e;
    font-size: 1rem;
    margin-bottom: 25px;
    flex-grow: 1;
    line-height: 1.6;
  }
  .btn-readmore {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #2e7d32;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    padding-top: 15px;
    border-top: 1px solid #f0f0f0;
    transition: all 0.3s;
  }
  .post:hover .btn-readmore {
    color: #1b5e20;
    gap: 15px;
  }
  .section-subtitle {
     text-align: center;
     color: #7f8c8d;
     margin-bottom: 50px;
     font-size: 1.15rem;
  }

  /* Hero Slideshow Styles */
  .hero-slideshow {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    z-index: 0; /* Keep it behind text, overlay is index 0 as well, but overlay might be ::after */
    overflow: hidden;
  }
  .hero-slideshow .slide {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background-size: cover;
    background-position: center;
    opacity: 0;
    animation: crossFade 25s infinite; /* 5 slides * 5s each */
  }
  .hero-slideshow .slide:nth-child(1) {
    background-image: url('/images/slideshow/slide1.png');
    animation-delay: 0s;
  }
  .hero-slideshow .slide:nth-child(2) {
    background-image: url('/images/slideshow/slide2.png');
    animation-delay: 5s;
  }
  .hero-slideshow .slide:nth-child(3) {
    background-image: url('/images/slideshow/slide3.png');
    animation-delay: 10s;
  }
  .hero-slideshow .slide:nth-child(4) {
    background-image: url('/images/slideshow/slide4.png');
    animation-delay: 15s;
  }
  .hero-slideshow .slide:nth-child(5) {
    background-image: url('/images/slideshow/slide5.png');
    animation-delay: 20s;
  }

  @keyframes crossFade {
    0% { opacity: 0; transform: scale(1); }
    10% { opacity: 1; }
    25% { opacity: 1; }
    35% { opacity: 0; transform: scale(1.05); }
    100% { opacity: 0; transform: scale(1); }
  }
</style>

