<!--boiler plats-->
<% layout("../layoutes/EnteringBoilerplats") %>
<link rel="stylesheet" href="/css/login.css">

<div class="form-container">
  <h2>Verify & Reset</h2>
  <p style="text-align: center; font-size: 14px; margin-bottom: 20px;">OTP sent to <b><%= email %></b></p>

  <% if(typeof error !== 'undefined' && error) { %>
    <div class="alert">
        <p><%=error%></p>
    </div>
  <%}%>  

  <form action="/forget-verify" method="POST">
    <div class="form-group">
      <label for="otp">Enter OTP</label>
      <input type="text" id="otp" name="otp" required autocomplete="off" style="letter-spacing: 3px; font-weight: bold; text-align: center;">
    </div>

    <div class="form-group">
      <label for="new_password">New Password</label>
      <div class="password-wrapper">
        <input type="password" id="new_password" name="new_password" required>
        <span class="toggle-password" onclick="togglePasswordVis('new_password', this)"><i class="fa-solid fa-eye-slash"></i></span>
      </div>
    </div>

    <div class="form-actions">
      <button type="submit">Update Password</button>
    </div>
  </form>
  
  <div class="register-link">
     <a href="/login">Cancel</a>
  </div>
</div>

<script>
  function togglePasswordVis(inputId, iconSpan) {
    const input = document.getElementById(inputId);
    const icon = iconSpan.querySelector('i');
    if (input.type === "password") {
      input.type = "text";
      icon.classList.remove('fa-eye-slash');
      icon.classList.add('fa-eye');
    } else {
      input.type = "password";
      icon.classList.remove('fa-eye');
      icon.classList.add('fa-eye-slash');
    }
  }
</script>
